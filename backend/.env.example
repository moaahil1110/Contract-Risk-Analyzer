# API Keys
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4-flash

# Supabase (Week 3)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
# Required only for legacy HS256 JWT signing. Current Supabase ECC/RSA signing keys use JWKS.
SUPABASE_JWT_SECRET=
# Optional override. Defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_BUCKET=contracts

# Background jobs
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_DEFAULT_QUEUE=celery
CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=1500
CELERY_TASK_TIME_LIMIT_SECONDS=1800
# Defaults to solo when DEV_MODE=true and prefork when DEV_MODE=false.
# Override only when you know the deploy/runtime needs it.
CELERY_WORKER_POOL=
CELERY_WORKER_CONCURRENCY=
PROCESS_TYPE=web
RUN_WORKER_IN_WEB=false
LOCAL_UPLOAD_ROOT=./uploads

# ChromaDB
CHROMA_PERSIST_PATH=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_MODEL_PATH=
EMBEDDING_OFFLINE=false

# Application
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_OPENAPI=false

# API rate limits
RATE_LIMIT_UPLOAD_COUNT=10
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=3600
RATE_LIMIT_ANALYSE_COUNT=20
RATE_LIMIT_ANALYSE_WINDOW_SECONDS=3600
RATE_LIMIT_RERUN_COUNT=10
RATE_LIMIT_RERUN_WINDOW_SECONDS=3600
RATE_LIMIT_EXPORT_COUNT=30
RATE_LIMIT_EXPORT_WINDOW_SECONDS=3600

# LLM Provider circuit breaker and backoff
LLM_PROVIDER_ORDER=groq,opencode_go
LLM_PROVIDER_MAX_RETRIES=2
LLM_PROVIDER_COOLDOWN_SECONDS=60
LLM_PROVIDER_MAX_COOLDOWN_SECONDS=900
LLM_REQUEST_DELAY_MS=250

# Operations
STALE_JOB_TIMEOUT_MINUTES=30
ANALYSIS_ACTIVE_JOB_TIMEOUT_MINUTES=30
BUILD_BENCHMARKS_ON_START=true

# Development Mode (set to true to bypass auth for local testing)
DEV_MODE=false
