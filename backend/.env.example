# API Keys
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Supabase (Week 3)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
# Required only for legacy HS256 JWT signing. Current Supabase ECC/RSA signing keys use JWKS.
SUPABASE_JWT_SECRET=
# Optional override. Defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_BUCKET=contracts

# Background jobs
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
# Defaults to solo when DEV_MODE=true and prefork when DEV_MODE=false.
# Override only when you know the deploy/runtime needs it.
CELERY_WORKER_POOL=
CELERY_WORKER_CONCURRENCY=
LOCAL_UPLOAD_ROOT=./uploads

# ChromaDB
CHROMA_PERSIST_PATH=./chroma_db

# Application
DEBUG=true
LOG_LEVEL=INFO

# Development Mode (set to true to bypass auth for local testing)
DEV_MODE=false
